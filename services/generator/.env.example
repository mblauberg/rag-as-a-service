# OpenAI Configuration (Recommended for faster generation)
ENABLE_OPENAI=true
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_MODEL=openai:gpt-4o-mini

# Ollama Configuration (Optional - slower on CPU)
OLLAMA_URL=http://localhost:11434
ENABLE_OLLAMA=false

# Generation Settings
MAX_CHUNKS=5
TEMPERATURE=0.1
MAX_TOKENS=2000
TIMEOUT=30

# Service Configuration
PORT=8002
LOG_LEVEL=INFO

# External Providers (Optional)
ENABLE_ANTHROPIC=false
ANTHROPIC_API_KEY=

ENABLE_GOOGLE=false
GOOGLE_API_KEY=

# OpenAI Configuration (Primary provider)
ENABLE_OPENAI=true
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_MODEL=openai:gpt-5-mini

# Generation Settings
MAX_CHUNKS=5
TEMPERATURE=0.1
MAX_TOKENS=2000
TIMEOUT=30

# Service Configuration
PORT=8002
LOG_LEVEL=INFO

# External Providers (Optional)
ENABLE_ANTHROPIC=false
ANTHROPIC_API_KEY=

ENABLE_GOOGLE=false
GOOGLE_API_KEY=

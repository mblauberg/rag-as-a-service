# ============================================
# RaaS Generator API Keys (Kubernetes Secret)
# ============================================
# Copy this file to secret.yaml and replace placeholder values with your actual API keys
# DO NOT commit secret.yaml to version control
#
# To apply:
#   cp secret.yaml.template secret.yaml
#   # Edit secret.yaml with your keys
#   kubectl apply -f secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: generator-api-keys
  namespace: raas
type: Opaque
stringData:
  # OpenAI (Required)
  # Get your key from: https://platform.openai.com/api-keys
  OPENAI_API_KEY: "YOUR_OPENAI_API_KEY_HERE"

  # Anthropic (Optional)
  # Get your key from: https://console.anthropic.com/
  ANTHROPIC_API_KEY: "YOUR_ANTHROPIC_API_KEY_HERE"

  # Google (Optional)
  # Get your key from: https://makersuite.google.com/app/apikey
  GOOGLE_API_KEY: "YOUR_GOOGLE_API_KEY_HERE"

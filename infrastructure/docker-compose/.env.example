# External Model Provider API Keys

# OpenAI - Get key from: https://platform.openai.com/api-keys
# Recommended: Use OpenAI for faster generation (compared to local Ollama on CPU)
ENABLE_OPENAI=true
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic - Get key from: https://console.anthropic.com/settings/keys
ENABLE_ANTHROPIC=false
ANTHROPIC_API_KEY=

# Google - Get key from: https://makersuite.google.com/app/apikey
ENABLE_GOOGLE=false
GOOGLE_API_KEY=
